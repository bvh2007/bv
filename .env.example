PORT=3000
NODE_ENV=development
# MySQL cloud connection. Use a private connection string and SSL for remote DB.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
DB_SSL=true
SESSION_SECRET=CHANGE_TO_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Admin created with: npm run? Use node scripts/create-admin.js EMAIL PASSWORD
# Cloudinary private/authenticated media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Only set when behind Render's trusted reverse proxy (production)
TRUST_PROXY=1
